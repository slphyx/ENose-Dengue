 CellChangeTimes->{{3.9833292128857956`*^9, 3.983329220968567*^9}, 
   3.9840180024979687`*^9},ExpressionUUID->"16fa29e1-f68b-6647-9662-\
4471d801d625"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "ReadODR", "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{"\"\<Plot\>\"", "->", "True"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ReadODR", "[", 
    RowBox[{"fn_", ",", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"tmp", ",", "tmp2", ",", "data", ",", "timels", ",", "outmat"}],
       "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"data", "=", 
       RowBox[{"Import", "[", "fn", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"tmp", "=", 
       RowBox[{"StringSplit", "[", 
        RowBox[{"data", ",", "\"\< \>\""}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"timels", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"i", "/", "100."}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"Length", "@", "tmp"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"tmp2", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"StringSplit", "[", 
           RowBox[{
            RowBox[{"tmp", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", "\"\<,\>\""}], "]"}], "//", 
          "ToExpression"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "@", "tmp"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"outmat", "=", 
       RowBox[{"tmp2", "\[Transpose]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"OptionValue", "[", "\"\<Plot\>\"", "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"ListPlot", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Thread", "[", 
             RowBox[{"{", 
              RowBox[{"timels", ",", "#"}], "}"}], "]"}], "&"}], "/@", 
           "outmat"}], ",", 
          RowBox[{"Joined", "->", "True"}], ",", 
          RowBox[{"Frame", "->", "True"}], ",", 
          RowBox[{"GridLines", "->", "Automatic"}], ",", 
          RowBox[{"FrameLabel", "->", 
           RowBox[{"{", 
            RowBox[{"\"\<time (min)\>\"", ",", "\"\<Response\>\""}], "}"}]}], 
          ",", 
          RowBox[{"PlotRange", "->", 
           RowBox[{"{", 
            RowBox[{"0", ",", "Automatic"}], "}"}]}], ",", 
          RowBox[{"LabelStyle", "->", 
           RowBox[{"Directive", "[", 
            RowBox[{"Bold", ",", " ", "Medium", ",", 
             RowBox[{"FontFamily", "->", "\"\<Times New Roman\>\""}]}], 
            "]"}]}], ",", 
          RowBox[{"PlotLegends", "->", 
           RowBox[{"LineLegend", "[", 
            RowBox[{
             RowBox[{"{", 
              
              RowBox[{"\"\<1\>\"", ",", "\"\<2\>\"", ",", "\"\<3\>\"", 
               ",", "\"\<4\>\""}], "}"}], ",", 
             RowBox[{"LegendLabel", "->", "\"\<Sensor\>\""}], ",", 
             RowBox[{"LegendFunction", "\[Rule]", "Framed"}]}], "]"}]}]}], 
         "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"Return", "[", 
         RowBox[{"tmp2", "\[Transpose]"}], "]"}]}], "\[IndentingNewLine]", 
       "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.984012759784689*^9, 3.984012770683401*^9}},
 CellLabel->
  "In[391]:=",ExpressionUUID->"48c3e0e7-bab1-bb41-a484-3f10deb8faf8"],

