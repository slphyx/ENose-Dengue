Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"rocs", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"val", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "\"\<ValidationResult\>\""}], "]"}], "]"}], 
         "[", "\"\<ROCData\>\"", "]"}], "[", "\"\<Dengue\>\"", "]"}], 
       "[", "\"\<ROCPoint\>\"", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"Length", "@", "val"}]}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Clean", " ", "one", " ", "ROC", " ", 
     RowBox[{"curve", ":", 
      RowBox[{
      "if", " ", "the", " ", "same", " ", "FPR", " ", "appears", " ", 
       "multiple", " ", "times"}]}]}], ",", 
    RowBox[{
    "keep", " ", "the", " ", "highest", " ", "TPR", " ", "at", " ", "that", " ",
      "FPR"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"cleanROC", "[", "roc_", "]"}], ":=", 
  RowBox[{"Values", "[", 
   RowBox[{"Last", "/@", 
    RowBox[{"GroupBy", "[", 
     RowBox[{"roc", ",", "First"}], "]"}]}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"cleanedROCs", "=", 
   RowBox[{"cleanROC", "/@", "rocs"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fprGrid", "=", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", "1", ",", "0.01"}], "]"}]}], ";"}], "\n", 
  RowBox[{"(*", 
   RowBox[{"Interpolate", " ", "each", " ", "cleaned", " ", "ROC"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"interp", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"Interpolation", "[", 
       RowBox[{"#", ",", 
        RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}], "&"}], "/@", 
     "cleanedROCs"}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Sample", " ", "all", " ", "curves", " ", "on", " ", "the", " ", "same", " ",
     "grid"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"tprMatrix", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"interp", "[", 
        RowBox[{"[", "k", "]"}], "]"}], "/@", "fprGrid"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", 
        RowBox[{"Length", "[", "interp", "]"}]}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Mean", " ", "ROC"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"meanTPR", "=", 
   RowBox[{"Mean", "/@", 
    RowBox[{"Transpose", "[", "tprMatrix", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"meanROC", "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"fprGrid", ",", "meanTPR"}], "}"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9839599059458923`*^9, 3.983959922982168*^9}, {
   3.9839599635341816`*^9, 3.983959971006872*^9}, {3.9839948586147404`*^9, 
   3.9839948592000675`*^9}, 
   3.9840122731115055`*^9},ExpressionUUID->"2f20d1b1-aa97-bb40-b1e1-\
cc252cda6c0c"],

